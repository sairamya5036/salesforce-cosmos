{
  "name": "casepulse-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Explainable SLA rescue console on Salesforce Headless 360",
  "scripts": {
    "test": "npm run check:metadata",
    "test:apex": "sf apex run test --class-names CasePulseTests --code-coverage --result-format human --wait 10",
    "check:metadata": "python3 scripts/python/check_metadata.py",
    "prettier": "prettier --write \"force-app/**/*.{cls,trigger,json,xml}\" \"manifest/*.xml\" \"docs/**/*.{json,md}\" \"*.{json,md}\" \"scripts/*.cjs\"",
    "prettier:verify": "prettier --check \"force-app/**/*.{cls,trigger,json,xml}\" \"manifest/*.xml\" \"docs/**/*.{json,md}\" \"*.{json,md}\" \"scripts/*.cjs\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "screenshots:hxl": "node scripts/capture-hxl.cjs",
    "screenshots:approval": "node scripts/capture-salesforce.cjs",
    "test:approval-ui": "node scripts/verify-approval-ui.cjs"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/cli": "2.154.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright": "^1.64.1",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,trigger,json,md,xml,cjs}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
