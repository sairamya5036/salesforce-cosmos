{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/text",
              "attributes": {
                "text": "CASEPULSE AI",
                "variant": "caption",
                "weight": "semibold"
              }
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$attrs.title}",
                "variant": "h1"
              }
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "Rescue critical cases before they become customer escalations.",
                "variant": "caption",
                "color": "muted"
              }
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "md",
                "isWrapped": true
              },
              "children": [
                {
                  "definition": "tile/container",
                  "attributes": {
                    "variant": "error"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.criticalCount}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Critical",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/container",
                  "attributes": {
                    "variant": "warning"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.highCount}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "High",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/container",
                  "attributes": {
                    "variant": "info"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.watchCount}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Watch",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/container",
                  "attributes": {
                    "variant": "success"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "md"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.healthyCount}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Healthy",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$attrs.analyzedAt}",
                "variant": "caption",
                "color": "muted"
              }
            },
            {
              "definition": "tile/container",
              "meta": {
                "forEach": "{!$attrs.cases}",
                "forItem": "$case"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "md",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$case.caseNumber}",
                            "variant": "caption"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$case.severity}",
                            "variant": "caption",
                            "color": "{!$case.color}"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$case.score}",
                            "variant": "h3"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$case.subject}",
                        "variant": "h3"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$case.owner}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$case.deadlineLabel}",
                        "variant": "caption"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$case.reasons}",
                        "variant": "body"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "md",
                        "isWrapped": true
                      },
                      "children": [
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "Prepare rescue",
                            "variant": "primary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/sendMessage",
                                  "attributes": {
                                    "content": "{!$case.rescuePrompt}"
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "Open case",
                            "variant": "secondary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/openLink",
                                  "attributes": {
                                    "url": "{!$case.recordUrl}"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "Your rescue queue is clear. No open cases are available in this scope."
              },
              "meta": {
                "if": "{!$attrs.empty}"
              }
            },
            {
              "definition": "tile/text",
              "attributes": {
                "text": "{!$attrs.notice}",
                "variant": "caption",
                "color": "muted"
              }
            },
            {
              "definition": "tile/button",
              "attributes": {
                "label": "Refresh risk analysis",
                "variant": "secondary",
                "actions": {
                  "click": [
                    {
                      "definition": "action/sendMessage",
                      "attributes": {
                        "content": "{!$attrs.refreshPrompt}"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
